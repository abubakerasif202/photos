# Secret used by the server to call Gemini. Never prefix with VITE_.
GEMINI_API_KEY=""

# Required in production. Generate a unique high-entropy token (at least 24 characters).
# Enter this token in the Image Studio when prompted. Do not commit its real value.
GENERATION_ACCESS_TOKEN=""

# Per-token hourly cap (single Node process). Also set hard provider-side budgets.
GENERATION_HOURLY_LIMIT=12

PORT=3000
APP_URL="http://localhost:3000"
